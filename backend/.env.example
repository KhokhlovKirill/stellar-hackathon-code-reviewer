# ---- Aegis environment (copy to .env, fill values; .env is gitignored) ----

# Core
AEGIS_ENV=dev                       # dev | prod
AEGIS_CONFIG_FILE=config.yaml
AEGIS_LOG_LEVEL=INFO

# Datastores
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis
AEGIS_REDIS_URL=redis://redis:6379/0

# Token vault — REQUIRED, 32-byte urlsafe-base64 Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AEGIS_VAULT_KEY=

# Admin portal bootstrap (first admin)
AEGIS_ADMIN_USER=admin
AEGIS_ADMIN_PASSWORD=

# Webhook secrets (per provider; can also be set per-repo in portal vault)
AEGIS_GITHUB_WEBHOOK_SECRET=
AEGIS_GITLAB_WEBHOOK_SECRET=
AEGIS_BITBUCKET_WEBHOOK_SECRET=

# LLM — OpenRouter (hackathon-provided key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GENERALIST_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_JUDGE_MODEL=deepseek/deepseek-v4-flash

# LLM — LM Studio (on host, Apple Silicon). From container use host.docker.internal.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_SECURE_MODEL=don-agent-v3
LMSTUDIO_BASE_MODEL=qwen3.6-35b-a3b-ud-mlx

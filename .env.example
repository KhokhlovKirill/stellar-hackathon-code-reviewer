# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-32-bytes-random-secret
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
DATABASE_SYNC_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM Providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...

# Primary model (Anthropic)
PRIMARY_LLM_MODEL=claude-sonnet-4-5
# Fallback via OpenRouter
FALLBACK_LLM_MODEL=qwen/qwen3-coder-30b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Encryption ──────────────────────────────────────────────────────────────
# Fernet key for encrypting stored tokens (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ─── GitLab ───────────────────────────────────────────────────────────────────
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# ─── LangSmith (optional) ────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aegis

# ─── OpenTelemetry (optional) ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis

# ─── Risk Engine ─────────────────────────────────────────────────────────────
RISK_BLOCK_THRESHOLD=60

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
MAX_DIFF_SIZE_KB=500
MAX_FILES_PER_SCAN=100
